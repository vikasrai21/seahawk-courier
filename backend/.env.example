# ═══════════════════════════════════════════════
#  SEAHAWK v2 — Environment Configuration
#  Copy this file to .env (development) or .env.production
#  NEVER commit real .env files to git
# ═══════════════════════════════════════════════

# ─── Node ────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/seahawk_v6"

# ─── JWT Secrets (use long random strings in production!) ─
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-64-char-random-string-in-production"
JWT_REFRESH_SECRET="change-this-too-different-from-above"

# ─── Token Expiry ──────────────────────────────────
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# ─── CORS (comma-separated origins for production) ──
# CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ─── Rate Limiting ─────────────────────────────────
LOGIN_RATE_MAX=10
GLOBAL_RATE_MAX=300
